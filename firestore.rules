rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: returns true if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: returns true if request is from document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection: Explicit separation of create, read, update, and delete operations
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Master Catalog Collection: Public read access; write access for authenticated users
    match /masterCatalog/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Shops & Inventory Subcollections
    match /shops/{shopId} {
      allow read: if true;
      allow write: if isOwner(shopId);

      match /inventory/{itemId} {
        allow read: if true;
        allow write: if isOwner(shopId);
      }
    }

    // Orders Collection
    match /orders/{orderId} {
      // Allow customers to read their own orders and shop owners to read assigned orders
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
      
      // Allow customers to create new orders
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      
      // Allow order updates by assigned shop owner or customer owner
      allow update: if isAuthenticated() && (
        resource.data.shopId == request.auth.uid ||
        resource.data.customerId == request.auth.uid
      );
    }
  }
}
